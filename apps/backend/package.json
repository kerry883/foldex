    "hono": "^4.12.14",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "resend": "^6.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
