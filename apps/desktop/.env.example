# Local API. Production builds default to https://api.foldex.space
# (also set on the GitHub release workflow).
VITE_API_URL=http://localhost:3000

# YouTube Data API key for the in-app video search tool.
# For releases, set the GitHub Actions secret VITE_GOOGLE_SEARCH_API_KEY
# instead of committing the key.
VITE_GOOGLE_SEARCH_API_KEY=
